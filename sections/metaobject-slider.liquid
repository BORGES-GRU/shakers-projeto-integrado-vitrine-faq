  {{ 'metaobject-slider.css' | asset_url | stylesheet_tag }}

  {%- assign selected_handle = section.settings.selected_product -%}
  {%- assign main_product = all_products[selected_handle] -%}

  <div class="metaobject-slider-wrapper" style="padding: 40px 0;">
    {%- if main_product != blank -%}
      {%- assign slider_entries = main_product.metafields.custom.related_products_with_banner.value -%}

      {%- if slider_entries != blank -%}
        <h2 class="slider-title" style="text-align: center; margin-bottom: 30px;">{{ section.settings.title }}</h2>
        
        <div class="swiper mySwiper">
          <div class="swiper-wrapper">
            {%- for item in slider_entries -%}
              {%- assign product_ref = item.product.value -%}
              {%- assign banner_img = item.banner.value -%}

              {%- if product_ref != blank -%}
                <div class="swiper-slide" style="text-align: center;">
                  <a href="{{ product_ref.url }}" style="text-decoration: none; color: inherit;">
                    
                    <div class="slider-image-container">
                      {%- if banner_img != blank -%}
                        {{ banner_img | image_url: width: 800 | image_tag: loading: 'lazy', class: 'lp-img', style: 'width: 100%; border-radius: 8px;' }}
                      {%- else -%}
                        {{ product_ref.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'lp-img' }}
                      {%- endif -%}
                    </div>

                    <h3 class="title" style="margin-top: 15px; font-size: 1.1rem;">{{ product_ref.title }}</h3>
                    <p class="price">{{ product_ref.price | money }}</p>
                  </a>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        
          <div class="swiper-button-next"></div>
          <div class="swiper-button-prev"></div>
          <div class="swiper-pagination"></div>
        </div>
      {%- else -%}
        <p style="text-align: center; color: #666;">Nenhum produto relacionado encontrado nos metacampos.</p>
      {%- endif -%}

    {%- else -%}
      <p style="text-align: center; padding: 20px; border: 1px dashed #ccc;">
        Por favor, selecione um <strong>Produto Base</strong> no menu lateral do Editor de Temas.
      </p>
    {%- endif -%}
  </div>

  {% schema %}
  {
    "name": "Metaobject Slider",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Título da Seção",
        "default": "Destaques Relacionados"
      },
      {
        "type": "product",
        "id": "selected_product",
        "label": "Produto Base"
      }
    ],
    "presets": [
      {
        "name": "Metaobject Slider"
      }
    ]
  }
  {% endschema %}