    <section class="hero-slider">
    <div class="hero-container">
        {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 1500 | image_tag: 
        loading: 'lazy',
        widths: '375, 550, 750',
        alt: section.settings.title,
        class: 'hero-slider__image'
    }}
    {% endif %}
        <div class="hero-text">
        <h1>{{ section.settings.title }}</h1>
        <p>{{ section.settings.subtext }}</p>
        <a href="{{ section.settings.button_link }}" class="btn">{{ section.settings.button_label }}</a>
        </div>
    </div>
    </section>

    {% schema %}
    {
    "name": "Hero Principal",
    "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem do Banner" },
        { "type": "text", "id": "title", "label": "Título Principal", "default": "PURE BALANCE" },
        { "type": "textarea", "id": "subtext", "label": "Texto de Apoio" },
        { "type": "text", "id": "button_label", "label": "Texto do Botão", "default": "Confira" },
        { "type": "url", "id": "button_link", "label": "Link do Botão" }
    ],
    "presets": [{ "name": "Hero Principal" }]
    }
    {% endschema %}